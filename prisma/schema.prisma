generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  category     String
  priceCents   Int
  image        String   @default("")
  badge        String?
  subscription Boolean  @default(false)
  rating       Float    @default(4.6)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants      Variant[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  subscriptions Subscription[]
}

model Variant {
  id         String @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String @default("")
  size       String @default("")
  stock      Int    @default(0)
  priceDelta Int    @default(0)

  cartItems CartItem[]

  @@unique([productId, color, size])
}

model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
}

model Order {
  id                String   @id @default(cuid())
  sessionId         String
  email             String
  subtotalCents     Int
  loyaltyCents      Int      @default(0)
  giftCardCents     Int      @default(0)
  totalCents        Int
  currency          String   @default("USD")
  totalMajor        Float    @default(0)
  status            String   @default("paid")
  giftCardCode      String?
  loyaltyPointsUsed Int      @default(0)
  hasSubscription   Boolean  @default(false)
  createdAt         DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  variantLabel   String  @default("")
  unitPriceCents Int
  quantity       Int
}

model GiftCard {
  id           String   @id @default(cuid())
  code         String   @unique
  balanceCents Int
  initialCents Int
  status       String   @default("active")
  createdAt    DateTime @default(now())

  transactions GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  amountCents Int
  orderId    String?
  note       String   @default("")
  createdAt  DateTime @default(now())
}

model LoyaltyAccount {
  id        String   @id @default(cuid())
  sessionId String   @unique
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  interval  String   @default("monthly")
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  kind      String   @default("transactional")
  sessionId String?
  createdAt DateTime @default(now())
}
